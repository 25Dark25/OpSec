{
	"schemaVersion": 1,
	"id": "opsec",
	"version": "${version}",
	"name": "OpSec",
	"description": "Client fingerprinting and tracking-exploit protection for Minecraft 1.21.11.",
	"authors": ["Aurick"],
	"contact": {
		"sources": "https://github.com/<tu-usuario>/OpSec",
		"issues": "https://github.com/<tu-usuario>/OpSec/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/opsec/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["aurick.opsec.mod.OpsecClient"],
		"modmenu": ["aurick.opsec.mod.config.OpsecModMenuIntegration"],
		"mixinsquared": ["aurick.opsec.mod.mixin.MeteorMixinCanceller"]
	},
	"mixins": [
		{ "config": "opsec.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${minecraft_version_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}